{
  "id": "fireAlarm",
  "name": "消防告警处理链",
  "nodes": {
    "recv": {
      "type": "log",
      "props": { "prefix": "[INPUT]" }
    },
    "riskFilter": {
      "type": "filter",
      "props": { "expr": "temp > 80" }
    },
    "enrich": {
      "type": "transform",
      "props": { "expr": "set:level=critical;tempF=$[temp]" }
    },
    "aiJudge": {
      "type": "aiDecision",
      "props": { "agent": "riskJudge" }
    },
    "persist": {
      "type": "asyncSink",
      "props": { "target": "tdengine" }
    },
    "discard": {
      "type": "log",
      "props": { "prefix": "[LOG]" }
    }
  },
  "edges": {
    "recv":       [ { "to": "riskFilter" } ],
    "riskFilter": [ { "to": "enrich", "relation": "True" },
                    { "to": "discard", "relation": "False" } ],
    "enrich":     [ { "to": "aiJudge" } ],
    "aiJudge":    [ { "to": "persist", "relation": "有隐患" },
                    { "to": "discard", "relation": "无隐患" } ]
  },
  "entry": [ "recv" ]
}
